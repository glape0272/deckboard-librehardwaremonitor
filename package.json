{
  "name": "deckboard-librehardwaremonitor",
  "version": "2.1.0",
  "description": "Display LibreHardwareMonitor sensor data on Deckboard using HTTP with legacy WMI fallback",
  "main": "index.js",
  "scripts": {
    "build": "deckboard-kit --build",
    "install:deckboard": "deckboard-kit --install",
    "check": "node --check index.js && node --check lib/lhm-client.js",
    "test": "node --test",
    "validate": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glape0272/deckboard-librehardwaremonitor.git"
  },
  "bugs": {
    "url": "https://github.com/glape0272/deckboard-librehardwaremonitor/issues"
  },
  "homepage": "https://github.com/glape0272/deckboard-librehardwaremonitor#readme",
  "author": "Riva Farabi",
  "contributors": [
    "glape0272"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=12"
  },
  "dependencies": {
    "deckboard-kit": "0.3.0",
    "node-wmi": "0.0.5"
  },
  "devDependencies": {
    "deckboard-kit-cli": "^1.1.3"
  }
}
